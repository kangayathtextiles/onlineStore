# ==============================================================================
# KANGAYATH WEB — ROOT ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to .env for docker-compose usage:
#    cp .env.example .env
# 2. For local backend development without Docker, copy apps/api/.env.example to apps/api/.env
# 3. For local frontend development, copy apps/web/.env.example to apps/web/.env.local
# 4. NEVER commit real credentials, passwords, or secrets to version control
# ==============================================================================

# --- Global Environment ---
ENVIRONMENT=development               # development | test | staging | production
DEBUG=false                            # Enable debug mode (MUST be false in production)
LOG_LEVEL=INFO                         # DEBUG | INFO | WARNING | ERROR

# --- Security ---
SECRET_KEY=CHANGEME-dev-only-insecure-key
# Production: Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"

# --- Backend (API) Settings ---
API_HOST=0.0.0.0
API_PORT=8000
API_V1_STR=/api/v1
PROJECT_NAME="Kangayath Web API"
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# Production: BACKEND_CORS_ORIGINS=https://kangayath.in,https://www.kangayath.in

# --- Database Settings (Host Connection) ---
# When connecting from Windows host tools (DBeaver, psql, etc.) to Docker PostgreSQL:
POSTGRES_SERVER=localhost
POSTGRES_PORT=5433
POSTGRES_USER=kangayath_user
POSTGRES_PASSWORD=kangayath_dev_password
POSTGRES_DB=kangayath_db
DATABASE_URL=postgresql+asyncpg://kangayath_user:kangayath_dev_password@localhost:5433/kangayath_db

# --- Docker Compose Port Mapping ---
# Host port 5433 maps to container port 5432 to prevent collisions with native PostgreSQL
POSTGRES_EXTERNAL_PORT=5433
API_EXTERNAL_PORT=8000
WEB_EXTERNAL_PORT=3000

# --- Database Pool ---
DB_POOL_SIZE=5                         # Number of persistent connections
DB_MAX_OVERFLOW=10                     # Max temporary connections above pool_size
DB_POOL_TIMEOUT=30                     # Seconds to wait for a connection

# --- Media / Uploads ---
MEDIA_ROOT=./media                     # Local file storage path
MAX_UPLOAD_SIZE_MB=10                  # Maximum upload file size in MB
ALLOWED_IMAGE_EXTENSIONS=.jpg,.jpeg,.png,.webp,.gif

# --- Frontend (Web) Settings ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Kangayath Web"
