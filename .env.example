# ==============================================================================
# KANGAYATH WEB — ROOT ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to .env.local or apps/api/.env and apps/web/.env.local as needed
# 2. Never commit real credentials, passwords, or secrets to version control
# ==============================================================================

# --- Global Environment ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Backend (API) Settings ---
API_HOST=0.0.0.0
API_PORT=8000
API_V1_STR=/api/v1
PROJECT_NAME="Kangayath Web API"
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# --- Database Settings ---
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=kangayath_user
POSTGRES_PASSWORD=kangayath_dev_password
POSTGRES_DB=kangayath_db
DATABASE_URL=postgresql+asyncpg://kangayath_user:kangayath_dev_password@localhost:5432/kangayath_db

# --- Frontend (Web) Settings ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME="Kangayath Web"
