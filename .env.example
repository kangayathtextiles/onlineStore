# ==============================================================================
# KANGAYATH WEB — ROOT ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to .env for docker-compose usage
# 2. Copy apps/api/.env.example to apps/api/.env for local backend development
# 3. Copy apps/web/.env.example to apps/web/.env.local for local frontend development
# 4. NEVER commit real credentials, passwords, or secrets to version control
# ==============================================================================

# --- Global Environment ---
ENVIRONMENT=development               # development | test | staging | production
DEBUG=false                            # Enable debug mode (MUST be false in production)
LOG_LEVEL=INFO                         # DEBUG | INFO | WARNING | ERROR

# --- Security ---
SECRET_KEY=CHANGEME-generate-a-64-char-random-string
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"

# --- Backend (API) Settings ---
API_HOST=0.0.0.0
API_PORT=8000
API_V1_STR=/api/v1
PROJECT_NAME="Kangayath Web API"
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# Production: BACKEND_CORS_ORIGINS=https://kangayath.in,https://www.kangayath.in

# --- Database Settings ---
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=kangayath_user
POSTGRES_PASSWORD=kangayath_dev_password
# Production: Use a secure randomly generated password
POSTGRES_DB=kangayath_db
DATABASE_URL=postgresql+asyncpg://kangayath_user:kangayath_dev_password@localhost:5432/kangayath_db

# --- Database Pool ---
DB_POOL_SIZE=5                         # Number of persistent connections
DB_MAX_OVERFLOW=10                     # Max temporary connections above pool_size
DB_POOL_TIMEOUT=30                     # Seconds to wait for a connection

# --- Media / Uploads ---
MEDIA_ROOT=./media                     # Local file storage path
MAX_UPLOAD_SIZE_MB=10                  # Maximum upload file size in MB
ALLOWED_IMAGE_EXTENSIONS=.jpg,.jpeg,.png,.webp,.gif

# --- Frontend (Web) Settings ---
NEXT_PUBLIC_API_URL=http://localhost:8000
# Production: NEXT_PUBLIC_API_URL=https://api.kangayath.in
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Production: NEXT_PUBLIC_SITE_URL=https://kangayath.in
NEXT_PUBLIC_APP_NAME="Kangayath Web"

# --- Docker Compose Port Mapping ---
POSTGRES_EXTERNAL_PORT=5432
API_EXTERNAL_PORT=8000
WEB_EXTERNAL_PORT=3000

