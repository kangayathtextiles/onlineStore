# Root .gitignore for KANGAYATH WEB

# Environment and Secrets (CRITICAL: NEVER COMMIT)
.env
.env.*
!.env.example
!.env.development.example
!.env.test.example
!.env.production.example
*.pem
*.key
*.cert
*.crt
secrets/

# Database
*.db
*.sqlite3

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
develop-eggs/
dist/
downloads/
eggs/
.eggs/
apps/api/lib/
apps/api/lib64/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments & Testing / Linting Caches
.venv/
venv/
ENV/
env/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Node & Next.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.next/
out/
.vercel
*.tsbuildinfo
next-env.d.ts

# Explicitly preserve Next.js source lib directory
!apps/web/lib/

# Local User Uploads & Temporary Media (tracked seed media in media/ is preserved)
apps/api/media/

# IDE & OS
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini

# Scratch / Local Diagnostic Tools
scratch/
*.log
docker-data/
postgres-data/
