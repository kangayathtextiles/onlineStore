# ==============================================================================
# KANGAYATH WEB — Production Environment Template (.env.production.example)
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to .env (or .env.production) for production docker-compose:
#    cp .env.production.example .env
# 2. Fill in your real production values.
# 3. NEVER commit .env or real credentials to version control.
# ==============================================================================

# --- Global Environment ---
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# --- Security Secrets ---
# Minimum 32-character random string:
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=your_production_secret_key_minimum_32_characters

# Minimum 32-character secure secret token for admin API endpoints:
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=your_production_admin_api_key_minimum_32_characters

# --- Production PostgreSQL Connection ---
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=kangayath_user
POSTGRES_PASSWORD=your_secure_postgres_password
POSTGRES_DB=kangayath_db
POSTGRES_EXTERNAL_PORT=5432

# Database connection pool
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# --- Object Storage (Supabase Storage) ---
# Required in production. Filesystem on cloud containers is ephemeral.
STORAGE_BACKEND=supabase
# Your Supabase Project URL:
SUPABASE_URL=https://your-project.supabase.co
# Your Supabase Secret Service Role Key (from Supabase Dashboard -> Project Settings -> API):
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_service_role_key_here
SUPABASE_STORAGE_BUCKET=product-media

# --- Media Upload Limits ---
MEDIA_ROOT=/app/media
MAX_UPLOAD_SIZE_MB=10
ALLOWED_IMAGE_EXTENSIONS=.jpg,.jpeg,.png,.webp,.gif

# --- Domain & CORS ---
BACKEND_CORS_ORIGINS=https://kangayath.site,https://www.kangayath.site
SITE_URL=https://kangayath.site

# --- Public Frontend URLs (baked into Next.js bundle / rewrites) ---
NEXT_PUBLIC_API_URL=https://api.kangayath.site
NEXT_PUBLIC_SITE_URL=https://kangayath.site
NEXT_PUBLIC_APP_NAME="Kangayath Web"
