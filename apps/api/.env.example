# ==============================================================================
# KANGAYATH WEB — Backend Environment Configuration Template (.env.example)
# ==============================================================================
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
SECRET_KEY=CHANGEME-dev-only-insecure-key
ADMIN_API_KEY=kangayath_admin_secret_key
# Production: Required >=32 characters: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_HOST=0.0.0.0
API_PORT=8000
API_V1_STR=/api/v1
PROJECT_NAME="Kangayath Web API"
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database connection when connecting to Docker PostgreSQL from host (port 5433):
POSTGRES_SERVER=localhost
POSTGRES_PORT=5433
POSTGRES_USER=kangayath_user
POSTGRES_PASSWORD=kangayath_dev_password
POSTGRES_DB=kangayath_db
DATABASE_URL=postgresql+asyncpg://kangayath_user:kangayath_dev_password@localhost:5433/kangayath_db

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

MEDIA_ROOT=./media
MAX_UPLOAD_SIZE_MB=10
ALLOWED_IMAGE_EXTENSIONS=.jpg,.jpeg,.png,.webp,.gif
STORAGE_BACKEND=local
# Production: Set STORAGE_BACKEND=supabase

# Supabase Storage — required in staging/production when STORAGE_BACKEND=supabase
# Get these from https://supabase.com/dashboard/project/<project-ref>/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_STORAGE_BUCKET=product-media

SITE_URL=http://localhost:3000
