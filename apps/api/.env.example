# KANGAYATH WEB — Backend Environment Configuration (.env.example)
ENVIRONMENT=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
API_V1_STR=/api/v1
PROJECT_NAME="Kangayath Web API"
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=kangayath_user
POSTGRES_PASSWORD=kangayath_dev_password
POSTGRES_DB=kangayath_db
DATABASE_URL=postgresql+asyncpg://kangayath_user:kangayath_dev_password@localhost:5432/kangayath_db
